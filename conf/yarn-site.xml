<configuration>

    <!-- ============================================================ -->
    <!-- ResourceManager                                              -->
    <!-- ============================================================ -->

    <!-- Nom d'hôte du ResourceManager (nom du service dans le compose) -->
    <property>
        <name>yarn.resourcemanager.hostname</name>
        <value>resourcemanager</value>
    </property>

    <!-- ============================================================ -->
    <!-- NodeManager                                                  -->
    <!-- ============================================================ -->

    <!-- Service de shuffle : transfère les sorties des mappers
         vers les reducers (indispensable à MapReduce) -->
    <property>
        <name>yarn.nodemanager.aux-services</name>
        <value>mapreduce_shuffle</value>
    </property>

    <!-- Variables d'environnement que les NodeManagers transmettent
         aux containers YARN -->
    <property>
        <name>yarn.nodemanager.env-whitelist</name>
        <value>JAVA_HOME,HADOOP_HOME,HADOOP_COMMON_HOME,HADOOP_HDFS_HOME,HADOOP_CONF_DIR,HADOOP_YARN_HOME,HADOOP_MAPRED_HOME,PATH</value>
    </property>

</configuration>